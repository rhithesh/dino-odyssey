{
  "manifest_version": 3,
  "name": "No Internet: Dino Odyssey",
  "short_name": "Dino Odyssey",
  "version": "1.0.0",
  "description": "The offline dino game, reimagined: 8 cinematic levels, bosses, wild twists and a chiptune soundtrack — right in your sidebar.",
  "action": {
    "default_title": "Play Dino Odyssey",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel"],
  "minimum_chrome_version": "116"
}
